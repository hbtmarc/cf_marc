{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "finance": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['schemaVersion', 'updatedAt', 'data']) && newData.child('schemaVersion').val() === 'cfm.cloud.v1' && newData.child('updatedAt').isNumber() && newData.child('data').exists()"
        }
      }
    }
  }
}
